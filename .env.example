# Secrets of the platform (D-011). Copy to `.env` (not versioned), fill in the values and load it
# in Git Bash before `terraform apply` in infra/terraform/bootstrap:
#   set -a; source .env; set +a

# P1 Ingestion
export TF_VAR_polaris_db_password=          # PostgreSQL of Polaris
export TF_VAR_polaris_root_client_secret=   # Polaris root principal (client id `root`)
export TF_VAR_sample_source_db_password=    # Sample PostgreSQL source (MovieLens)

# P2 Processing (Trino password file, D-026)
export TF_VAR_trino_admin_password=         # Trino user `admin` (technical team)
export TF_VAR_trino_metabase_password=      # Trino service user `metabase` (BI)
export TF_VAR_trino_external_users='{}'     # JSON map of external system user -> password
export TF_VAR_trino_shared_secret=          # Trino internal communication shared secret

# P3 Orchestration
export TF_VAR_airflow_api_secret_key=       # Airflow API server secret key
export TF_VAR_airflow_admin_password=       # Airflow user `admin`

# P4 BI
export TF_VAR_metabase_db_password=         # PostgreSQL of Metabase

# P5 Observability (alerts by email, D-024)
export TF_VAR_grafana_admin_password=       # Grafana user `admin`
export TF_VAR_smtp_host=                    # SMTP server host
export TF_VAR_smtp_port=587                 # SMTP server port
export TF_VAR_smtp_username=                # SMTP user
export TF_VAR_smtp_password=                # SMTP password
export TF_VAR_alert_email_from=             # Sender address of the alerts
export TF_VAR_alert_email_to=               # Technical team address that receives the alerts

# P6 Governance
export TF_VAR_openmetadata_admin_password=  # OpenMetadata user `admin`
